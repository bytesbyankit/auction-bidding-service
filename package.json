{
  "name": "auction-bidding-service",
  "version": "1.0.0",
  "description": "High-concurrency auction bidding backend service with RethinkDB",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:concurrency": "jest --testPathPattern=concurrency.test.ts --runInBand --detectOpenHandles --forceExit",
    "seed": "tsx src/scripts/seed.ts"
  },
  "addition": 1,
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "rethinkdb-ts": "^3.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
